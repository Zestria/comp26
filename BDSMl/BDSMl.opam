opam-version: "2.0"
synopsis: "A small compiler"
maintainer: ["Filichkin Bogdan, Dalyshe sami"]
authors: ["Filichkin Bogdan, Dalyshe sami"]
license: "LGPL-3.0-or-later"
depends: [
  "ocaml"
  "dune" {>= "3.24"}
  "menhir" {build}
  "benchmark"
  "base"
  "ppx_expect" {with-test}
  "angstrom" {= "0.16.0"}
  "qcheck"
  "bisect_ppx_ng"
  "llvm" {= "18-shared"}
  "ppx_deriving_qcheck" {= "0.9"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
