(executable
 (name interp_check)
 (public_name MetaBannedInRfLanguage.interp_check)
 (package MetaBannedInRfLanguage)
 (modules interp_check)
 (libraries metabannedinrflanguage_frontend metabannedinrflanguage_middleend))

(cram
 (package MetaBannedInRfLanguage)
 (applies_to :standard \ codegen)
 (deps ../driver/compiler.exe ./interp_check.exe))

(cram
 (package MetaBannedInRfLanguage)
 (applies_to codegen)
 (deps ../driver/compiler.exe runtime_riscv.o))

; Build the shared runtime once; codegen.t links it into its test programs.

(rule
 (targets runtime_riscv.o)
 (deps ../backend/runtime.c)
 (action
  (run
   riscv64-linux-gnu-gcc
   -march=rv64gc
   -mabi=lp64d
   -O2
   -Wall
   -Wextra
   -Werror
   -c
   %{dep:../backend/runtime.c}
   -o
   %{targets})))
