(test
 (name riscv_tests)
 (modules riscv_tests)
 (package shmel)
 (libraries qcheck shmel.Lib shmel.Middleend shmel.Backend)
 (deps harness.c run_riscv.sh))

(test
 (name closure_layout_tests)
 (modules closure_layout_tests)
 (package shmel)
 (libraries shmel.Backend))

(test
 (name calls_tests)
 (modules calls_tests)
 (package shmel)
 (libraries shmel.Backend shmel.Middleend))

(test
 (name calls_integration_tests)
 (modules calls_integration_tests)
 (package shmel)
 (libraries qcheck shmel.Lib shmel.Middleend shmel.Backend)
 (deps
  run_riscv.sh
  ../../backend/closure_runtime.h
  ../../backend/closure_runtime.c))

(cram
 (package shmel)
 (deps riscv_tests.exe ../../compiler.exe))

(rule
 (alias runtest)
 (package shmel)
 (deps
  check_closure_runtime.sh
  run_riscv.sh
  closure_runtime_tests.c
  ../../backend/closure_runtime.h
  ../../backend/closure_runtime.c)
 (action
  (run sh %{dep:check_closure_runtime.sh})))

(rule
 (alias runtest-docker)
 (package shmel)
 (locks docker-riscv)
 (deps
  (universe)
  riscv_tests.exe
  calls_integration_tests.exe
  harness.c
  Dockerfile
  run_riscv.sh
  docker_runner.sh
  closure_runtime_tests.c
  ../../backend/closure_runtime.h
  ../../backend/closure_runtime.c)
 (action
  (progn
   (run ./riscv_tests.exe --runner docker)
   (run ./calls_integration_tests.exe --runner docker)
   (run sh docker_runner.sh runtime))))
