(library
 (name SchonfinkelML_backend)
 (modules emitter writer common allocator closures)
 (libraries SchonfinkelML_middleend)
 (package SchonfinkelML))

(foreign_library
 (archive_name schoml_runtime)
 (language c)
 (names runtime gc tuple closure)
 (flags (:standard -std=c11 -Wall -Wextra -Werror -pedantic)))

(install
 (package SchonfinkelML)
 (section lib)
 (files libschoml_runtime.a runtime.h gc.h tuple.h closure.h
        runtime.c gc.c tuple.c closure.c))