(** Свежие имена для всех проходов middleend.

    Счётчик один на всю программу, поэтому имена разных проходов не
    пересекаются. С пользовательскими именами они тоже не совпадают: rename
    переименовывает каждое пользовательское имя, содержащее [__]. *)

(** [name base] --- новое имя вида [base__N], например [name "t" = "t__17"]. *)
val name : string -> string

(** Сбросить счётчик: перед новой программой или тестом, но не между
    проходами одной программы. *)
val reset : unit -> unit
