(** Вход — AST после [Rename.rename], все связанные имена уникальны.
    Каждая вложенная [fun] получает свободные локальные переменные явными
    первыми параметрами в алфавитном порядке и сразу применяется к ним.
    Параметры получают новые имена из общего [Fresh], чтобы не создавать
    затенение. Глобальные переменные захватывать не нужно.
    Локальный [let rec] возвращает [Error]. Счётчик [Fresh] не сбрасывается. *)
val convert : Ast.structure -> (Ast.structure, string) result
