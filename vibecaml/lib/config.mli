(** Настройки компилятора из командной строки: выбор парсера, расширения
    синтаксиса, отладочный вывод и входной файл. *)

(** Какой синтаксический анализатор запускать. *)
type parser =
  | Recursive_descent (** нисходящий, [--parser rd] *)
  | Menhir (** восходящий, [--parser menhir] *)

(** Расширения синтаксиса нисходящего парсера (см. #5). По умолчанию выключены. *)
type extensions =
  { glued_keywords : bool
    (** идентификаторы, слипшиеся с ключевыми словами, [--ext-glued-keywords] *)
  ; operator_declarations : bool
    (** переопределение арности и ассоциативности операторов,
        [--ext-operator-declarations] *)
  }

type t =
  { parser : parser
  ; extensions : extensions
  ; dump_ast : bool (** напечатать AST, [--dump-ast] *)
  ; dump_pretty_printed : bool (** напечатать программу принтером, [--dump-pp] *)
  ; input_file : string option (** позиционный аргумент; [None] --- не задан *)
  }

(** Нисходящий парсер, расширения выключены, отладочного вывода нет, входного
    файла нет. *)
val default : t

(** Разобрать аргументы командной строки без побочных эффектов.

    Массив устроен как [Sys.argv]: нулевой элемент --- имя программы, он
    пропускается. Аргумент, не начинающийся с [-], считается входным файлом;
    одиночный [-] тоже попадает в [input_file], что он значит --- решает
    драйвер. Ошибка --- неизвестный флаг, флаг без значения, пустое имя файла
    или второй входной файл. *)
val parse_arguments : string array -> (t, string) result
