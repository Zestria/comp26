(** Печать AST в синтаксис подмножества OCaml.

    Операторы ядра печатаются инфиксно, скобки --- только там, где без них
    дерево вышло бы другим (приоритеты и ассоциативность из ADR 0001). Прочие
    операторы --- префиксно в скобках ([( @@ ) f x]). [( ~- ) e] печатается как
    [-e], кроме применения к целой константе: [-1] --- уже константа. Связывание
    функции, у которой первый параметр --- переменная, печатается сахаром
    [let f x y = e], остальные --- [let f = fun _ x -> e].

    Вывод переразбирается и OCaml, и обоими нашими парсерами в то же дерево: на
    этом держатся QuickCheck-тесты.

    Предусловие: каждый идентификатор в дереве --- то, что мог выдать парсер:
    имя со строчной буквы или [_] (не ключевое слово и не сам [_]) либо
    оператор. Для прочих строк round-trip не гарантирован: [Pat_var "_"]
    напечатается как [_] и прочтётся как [Pat_wildcard].

    Ограничение: [~-], применённый к целой константе, и голый [~-] печатаются
    вне ядра --- как [( ~- ) 1] и [( ~- )]. OCaml такой вывод прочтёт, а наши
    парсеры отвергнут: [~-] не входит в операторы подмножества. Парсеры таких
    деревьев не строят ([-1] разбирается в константу), генератор ядра тоже;
    широкий генератор строит их намеренно, для сверки с OCaml. *)

(** Операторы, которые печатаются инфиксно: бинарные операторы подмножества по
    уровням приоритета, от слабого к сильному. Генератор тестов берёт их
    отсюда, чтобы не разойтись с парсерами. *)
val binary_operators : Ast.identifier list list

(** Напечатать выражение. *)
val pp_expression : Format.formatter -> Ast.expression -> unit

(** Напечатать программу: объявления верхнего уровня, по одному на строку. *)
val pp_structure : Format.formatter -> Ast.structure -> unit

(** Получить строковое представление выражения. *)
val string_of_expression : Ast.expression -> string

(** Получить строковое представление программы. *)
val string_of_structure : Ast.structure -> string
