let plus = (+)
let add_ten = plus 10
let output = print_int
let () = output (add_ten 7)
let sum9 a b c d e f g h i = a + b + c + d + e + f + g + h + i
let partial = sum9 1 2 3 4 5 6 7 8
let () = output (partial 9)
let () = output (sum9 9 8 7 6 5 4 3 2 1)
let first = (20, (30, 40), 50)
let (x, (y, z), w) = first
let () = output (x + y + z + w)
let a' v = v + 1
let a_ v = v * 2
let () = output (a' 3 + a_ 3)
let () = let result = output 5 in if result = () then output 6 else output 7
