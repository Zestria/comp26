#!/bin/bash
#
# Show user stats (commits, files modified, insertions, deletions, and total
# lines modified) for a repo

set -e

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
git_log_opts=( "$@" )
log_paths=()

if [ -n "${LOGDIR:-}" ]; then
    log_paths=( "$LOGDIR" )
    members="$(yq --arg compiler "$LOGDIR" -c \
        '[.[] | to_entries[] | select(.key == $compiler) | .value[]]' \
        "$script_dir/../teams.yml")"
    author_pattern="$(printf '%s' "$members" | python3 "$script_dir/stats-authors.py")"
    if [ -n "$author_pattern" ]; then
        git_log_opts+=( --regexp-ignore-case --extended-regexp "--author=$author_pattern" )
    fi
fi

git log --format='author: %ae' "${git_log_opts[@]}" --numstat -- "${log_paths[@]}" \
    | tr '[A-Z]' '[a-z]' \
    | grep -v '^$' \
    | grep -v '^-' \
    | awk '
        {
            if ($1 == "author:") {
                author = $2;
                commits[author]++;
            } else {
                insertions[author] += $1;
                deletions[author] += $2;
                total[author] += $1 + $2;
                # if this is the first time seeing this file for this
                # author, increment their file count
                author_file = author ":" $3;
                if (!(author_file in seen)) {
                    seen[author_file] = 1;
                    files[author]++;
                }
            }
        }
        END {
            # Print a header
            printf("%s\n",
                   "| Email | Commits | Files | Insertions | Deletions | Total Lines |");
            printf("%s\n",
                   "| ----- | ------- | ----- | ---------- | --------- | --------- |");

            # Print the stats for each user, sorted by total lines
            n = asorti(total, sorted_emails, "@val_num_desc");
            for (i = 1; i <= n; i++) {
                email = sorted_emails[i];
                printf("| %-30s | %-5s | %-5s | %-5s | %-5s | %-5s |\n",
                       email, commits[email], files[email],
                       insertions[email], deletions[email], total[email]);
            }
            printf("%s\n",
                   "| ----- | ------- | ----- | ---------- | --------- | --------- |");
        }
'
